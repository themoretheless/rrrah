+    fn cost_refinement_preserves_integrals_and_charges_every_failed_attempt() {
+        let used = Arc::new(AtomicUsize::new(0));
+        let calls = Cell::new(0usize);
+        let deny = Cell::new(usize::MAX);
+        let admit = |bytes: usize| -> Option<Credit> {
+            calls.set(calls.get() + 1);
+            if calls.get() == deny.get() {
+                return None;
+            }
+            let total = used.load(Ordering::SeqCst).checked_add(bytes)?;
+            if total > 8 * 1024 * 1024 {
+                return None;
+            }
+            used.store(total, Ordering::SeqCst);
+            Some(Box::new(Reservation(used.clone(), bytes)))
+        };
+        let patch = source(0., 1., [0.25; 3]);
+        let refs = [AdaptivePatchRef::Tensor(&patch)];
+        let mut pool = ParamPool::new();
+        let mut records = Vec::new();
+        let mut credit = None;
+        for points in [
+            [Point::ZERO, Point::new(1., 0.), Point::new(0., 1.)],
+            [Point::new(1., 0.), Point::new(1., 1.), Point::new(0., 1.)],
+        ] {
+            let mut parameters = [[0; 2]; 3];
+            for (i, p) in points.iter().enumerate() {
+                parameters[i] = [
+                    pool.intern(p.x, &admit).unwrap(),
+                    pool.intern(p.y, &admit).unwrap(),
+                ];
+            }
+            push_record(
+                &mut records,
+                &mut credit,
+                Record {
+                    points,
+                    parameters,
+                    patch_index: 0,
+                },
+                &admit,
+            )
+            .unwrap();
+        }
+        let resident = used.load(Ordering::SeqCst);
+        let run = |depth, limit, work: &mut usize, cancelled: &dyn Fn() -> bool| {
+            integrate_cell_with_paint_limit(
+                &records,
+                &refs,
+                &pool,
+                &[None],
+                Point::ZERO,
+                1.,
+                depth,
+                512,
+                work,
+                cancelled,
+                &admit,
+                limit,
+            )
+        };
+        let expected = [1., 0.25, 0.25, 0.25, 0.];
+        let mut baseline_work = 100_000;
+        assert_eq!(
+            run(0, CELL_PAINT_WORK, &mut baseline_work, &|| false),
+            Some(expected)
+        );
+        calls.set(0);
+        let polls = Cell::new(0);
+        let mut refined_work = 100_000;
+        assert_eq!(
+            run(0, 0, &mut refined_work, &|| {
+                polls.set(polls.get() + 1);
+                false
+            }),
+            Some(expected)
+        );
+        let reservations = calls.get();
+        let checkpoints = polls.get();
+        let spent = 100_000 - refined_work;
+        assert!(
+            refined_work < baseline_work,
+            "coarse retries must not refund their work"
+        );
+        assert_eq!(used.load(Ordering::SeqCst), resident);
+        // The deepest leaf must use the original shared allowance, not retry
+        // the exhausted local budget or recurse beyond the existing depth.
+        let mut deepest_work = 100_000;
+        assert_eq!(run(8, 0, &mut deepest_work, &|| false), Some(expected));
+        assert_eq!(deepest_work, baseline_work);
+        for n in 1..=reservations {
+            calls.set(0);
+            deny.set(n);
+            assert!(run(0, 0, &mut 100_000, &|| false).is_none());
+            assert_eq!(used.load(Ordering::SeqCst), resident);
+            deny.set(usize::MAX);
+            assert_eq!(run(0, 0, &mut 100_000, &|| false), Some(expected));
+        }
+        for n in 1..=checkpoints {
+            polls.set(0);
+            assert!(
+                run(0, 0, &mut 100_000, &|| {
+                    polls.set(polls.get() + 1);
+                    polls.get() == n
+                })
+                .is_none()
+            );
+            assert_eq!(used.load(Ordering::SeqCst), resident);
+        }
+        for n in 0..spent {
+            let mut work = n;
+            assert!(run(0, 0, &mut work, &|| false).is_none());
+            assert!(work <= n);
+            assert_eq!(used.load(Ordering::SeqCst), resident);
+        }
+        assert_eq!(run(0, 0, &mut 100_000, &|| false), Some(expected));
+        eprintln!(
+            "CELL_COST_CONTROL admissions={reservations} cancel_points={checkpoints} short_quotas={spent}"
+        );
+        drop(records);
+        drop(credit);
+        drop(pool);
+        assert_eq!(used.load(Ordering::SeqCst), 0);
+    }
