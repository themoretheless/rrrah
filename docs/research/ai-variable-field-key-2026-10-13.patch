+#[test]
+fn field_reset_reuses_storage_without_giving_stale_tail_identity() {
+    let observation=FieldObservation::new();observation.reset(7);
+    for command in 0..4 {assert!(observation.append(command,Some(SourceFieldIdentity::RasterCells([command as u64+1,9]))));}
+    let initial=observation.work.replace(0);assert_eq!(initial,19+4*4);
+    observation.reset(8);assert_eq!(observation.work.replace(0),3);
+    assert!(observation.append(2,Some(SourceFieldIdentity::AffineOwner(11))));
+    let key=observation.key.borrow();let key=key.as_ref().unwrap();
+    let mut fresh=FieldKey::route(8);fresh.append(2,SourceFieldIdentity::AffineOwner(11)).unwrap();
+    assert_eq!(key.len,fresh.len);assert_eq!(key.words[..key.len],fresh.words[..fresh.len]);
+    assert_ne!(key.words[key.len..],fresh.words[fresh.len..]);
+}
