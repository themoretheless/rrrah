 impl RasterCells {
+    pub(super) fn has_texel_grid(&self)->bool {self.grid.is_some()}
+    /// Geometry index to native nearest texel identity. Footprint and arbitrary
+    /// line partitions have no texel identity. Source/transform remain external.
+    pub(super) fn texel_key(&self,path_index:usize)->Option<u64> {
+        if path_index==0 || path_index>=self.paths.len() {return None;}
+        let grid=self.grid?;
+        let columns=usize::try_from(grid.x1.checked_sub(grid.x0)?).ok()?;
+        let rows=usize::try_from(grid.y1.checked_sub(grid.y0)?).ok()?;
+        let index=path_index.checked_sub(1)?;
+        if columns==0 || index>=columns.checked_mul(rows)? {return None;}
+        let x=grid.x0.checked_add(u32::try_from(index%columns).ok()?)?;
+        let y=grid.y0.checked_add(u32::try_from(index/columns).ok()?)?;
+        Some((u64::from(x)<<32)|u64::from(y))
+    }
     pub(super) fn into_parts(self)->(Vec<BezPath>,Box<dyn std::any::Any+Send+Sync>) {
