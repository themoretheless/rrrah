+            lo=lo.min(v.lo);hi=hi.max(v.hi);
+        }
+        let lo=(lo-self.error).next_down();let hi=(hi+self.error).next_up();
+        MeshWeightInterval::new(lo,hi).map(|v|[v.lo,v.hi])
+    }
