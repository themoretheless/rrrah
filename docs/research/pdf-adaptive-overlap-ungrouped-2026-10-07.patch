+// Bounded quadtree integration preserves painter order without accumulating
+// polygon fragments. Full cells and single-triangle cells integrate analytically.
+fn integrate_mesh_cell(
+    triangles: &[Triangle], candidates: &[usize], origin: Point, extent: f64,
+    depth: u8, sample: &mut MeshSample,
+) {
+    let mut active = smallvec::SmallVec::<[(usize, f32, Point); 8]>::new();
+    for &index in candidates.iter().rev() {
+        let t = &triangles[index];
+        let bounds = t.bounding_box();
+        if bounds.x1 <= origin.x || bounds.x0 >= origin.x + extent
+            || bounds.y1 <= origin.y || bounds.y0 >= origin.y + extent { continue; }
+        if let Some((area, center)) = triangle_cell_area(t, origin, extent) {
+            if active.is_empty() && f64::from(area) >= extent * extent * (1.0 - 1e-6) {
+                add_mesh_area(sample, t, area, center);
+                return;
+            }
+            active.push((index, area, center));
+        }
+    }
+    if active.is_empty() { return; }
+    if active.len() == 1 {
+        let (index, area, center) = active[0];
+        add_mesh_area(sample, &triangles[index], area, center);
+        return;
+    }
+    if depth == 8 {
+        let point = origin + kurbo::Vec2::new(extent * 0.5, extent * 0.5);
+        for (index, _, _) in active {
+            let t = &triangles[index];
+            let p = [t.p0.point, t.p1.point, t.p2.point];
+            let cross = |a: Point, b: Point| (b.x-a.x)*(point.y-a.y)-(b.y-a.y)*(point.x-a.x);
+            let edges = [cross(p[0],p[1]),cross(p[1],p[2]),cross(p[2],p[0])];
+            if edges.iter().all(|v| *v >= -1e-12) || edges.iter().all(|v| *v <= 1e-12) {
+                add_mesh_area(sample, t, (extent * extent) as f32, point);
+                return;
+            }
+        }
+        return;
+    }
+    let indices: smallvec::SmallVec<[usize; 8]> = active.iter().rev().map(|v| v.0).collect();
+    let half = extent * 0.5;
+    for (x,y) in [(0.,0.),(half,0.),(0.,half),(half,half)] {
+        integrate_mesh_cell(triangles, &indices, origin + kurbo::Vec2::new(x,y), half, depth+1, sample);
+    }
+}
