{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/d4ncboz/threads-affiliate/schemas/hooks.schema.json",
  "title": "Hook Template Schema",
  "description": "Schema for hooks_{category}.json files in templates/ directory",
  "type": "object",
  "required": ["_meta", "hooks"],
  "properties": {
    "_meta": {
      "type": "object",
      "required": ["category", "language", "version"],
      "properties": {
        "category": {
          "type": "string",
          "enum": ["skincare", "parfum", "haircare", "makeup", "fashion", "gadget", "food", "baby"],
          "description": "Affiliate product category"
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2}-[A-Z]{2}$",
          "description": "BCP-47 language tag, default id-ID"
        },
        "tone": {
          "type": "string",
          "enum": ["casual-genz", "casual-millennial", "professional", "formal"],
          "description": "Writing tone register"
        },
        "audience": {
          "type": "string",
          "description": "Target audience description"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+(\\.\\d+)?$",
          "description": "Semver version of this template file"
        }
      }
    },
    "hooks": {
      "type": "object",
      "description": "Hook style → list of variant templates",
      "minProperties": 1,
      "patternProperties": {
        "^(edukasi|validasi_mental|storytelling|problem_solving|hook_pancingan|transformasi|social_proof|urgency|controversy|[a-z_]+)$": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 10,
            "maxLength": 200,
            "description": "Hook template with {product} placeholder",
            "pattern": ".*\\{product\\}.*"
          }
        }
      }
    }
  },
  "examples": [
    {
      "_meta": {
        "category": "skincare",
        "language": "id-ID",
        "tone": "casual-genz",
        "audience": "Indonesian 16-30 yo",
        "version": "1.0"
      },
      "hooks": {
        "edukasi": [
          "Tau gak, {product} itu underrated banget 🔥",
          "Banyak yang gak tau {product} cocok buat kulit sensitive 📚"
        ],
        "storytelling": [
          "3 bulan pake {product}, kulit gw berubah total 😤"
        ]
      }
    }
  ]
}
