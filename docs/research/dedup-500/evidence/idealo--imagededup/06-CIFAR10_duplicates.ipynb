      },
      "source": [
        "# find duplicates in the entire dataset with CNN\n",
        "from imagededup.methods import CNN\n",
        "\n",
        "cnn = CNN()\n",
        "encodings = cnn.encode_images(image_dir=image_dir)\n",
        "duplicates = cnn.find_duplicates(encoding_map=encodings)"
      ],
      "execution_count": 4,
