    {
      "path": "tests/test_clustering/clustering_fixture.csv",
      "mode": "100644",
      "type": "blob",
      "sha": "d6e9b16ecd53522302d8c7ad8444ab97cc833cf3",
      "size": 260,
      "url": "https://api.github.com/repos/fritshermans/deduplipy/git/blobs/d6e9b16ecd53522302d8c7ad8444ab97cc833cf3",
      "sha256": "0b3ba8c3a1eba4f9656dbded60a5891fc8370af562fea8dc5cc9f62cf03612b5",
      "fully_read_this_turn": true,
      "text_content": "name_1,row_number_1,name_2,row_number_2,score\nfrits,0,frits h,1,0.90\nfrits,0,stan,2,0.10\nfrits,0,stein,3,0.10\nfrits,0,ahmet,4,0.10\nfrits h,1,stan,2,0.10\nfrits h,1,stein,3,0.10\nfrits h,1,ahmet,4,0.10\nstan,2,stein,3,0.40\nstan,2,ahmet,4,0.10\nstein,3,ahmet,4,0.10\n"
    },
    {
      "path": "tests/test_clustering/test_clustering.py",
      "mode": "100644",
      "type": "blob",
      "sha": "c11bd124963b33527e1f79dd5edfafbe25a60867",
      "size": 1034,
      "url": "https://api.github.com/repos/fritshermans/deduplipy/git/blobs/c11bd124963b33527e1f79dd5edfafbe25a60867",
      "sha256": "36d0a0ff39aba648d11dbea54995e18ed8440989c94fcc5e7a1dc3128cd4f2a7",
      "fully_read_this_turn": true,
      "text_content": "import os\n\nimport pandas as pd\n\nfrom deduplipy.clustering.clustering import hierarchical_clustering\n\n\ndef test_hierarchical_clustering_base():\n    col_names = ['name']\n    scored_pairs_table = pd.read_csv(os.path.join('tests', 'test_clustering', 'clustering_fixture.csv'))\n    res = hierarchical_clustering(scored_pairs_table, col_names)\n    expected = pd.DataFrame({'deduplication_id': [1, 1, 2, 3, 4],\n                             'row_number': [0, 1, 2, 3, 4]})\n    pd.testing.assert_frame_equal(res, expected, check_dtype=False)\n    assert True\n\n\ndef test_hierarchical_clustering_cluster_threshold():\n    col_names = ['name']\n    scored_pairs_table = pd.read_csv(os.path.join('tests', 'test_clustering', 'clustering_fixture.csv'))\n    res = hierarchical_clustering(scored_pairs_table, col_names, cluster_threshold=0.4)\n    expected = pd.DataFrame({'deduplication_id': [1, 1, 2, 2, 3],\n                             'row_number': [0, 1, 2, 3, 4]})\n    pd.testing.assert_frame_equal(res, expected, check_dtype=False)\n    assert True\n"
    },
    {
      "path": "tests/test_clustering/test_fill_missing_edges.py",
      "mode": "100644",
      "type": "blob",
      "sha": "23f82f379f0842989a943b2d07b72ca138c466f6",
      "size": 1760,
      "url": "https://api.github.com/repos/fritshermans/deduplipy/git/blobs/23f82f379f0842989a943b2d07b72ca138c466f6",
      "sha256": "8b46fe14d6af0d4c3736b2f36c2a268da71914b012e308a345a78ed4342a5ecb",
      "fully_read_this_turn": true,
      "text_content": "import numpy as np\n\nfrom deduplipy.clustering.fill_missing_edges import fill_missing_links\nfrom scipy.stats import random_correlation\n\n\ndef get_random_matrix_missing_values(size, fraction):\n    eigenvalues = np.arange(1, 1 + size)\n    eigenvalues = eigenvalues / sum(eigenvalues)\n    eigenvalues = eigenvalues * len(eigenvalues)\n    matrix = random_correlation.rvs(eigenvalues)\n\n    matrix_missing = matrix.copy()\n    mask = np.random.randint(0, 100, size=(size, size)) > 100 * (1 - fraction)\n    matrix_missing[mask] = 0\n    matrix_missing = np.triu(matrix_missing) + np.triu(matrix_missing).T\n    np.fill_diagonal(matrix_missing, 1)\n    np.fill_diagonal(matrix, 0)\n    return matrix, matrix_missing\n\n\ndef test_fill_missing_links_base():\n    matrix = np.asarray([[0, 0.8, 0],\n                         [0.8, 0, 0.8],\n                         [0, 0.8, 0]])\n    res = fill_missing_links(matrix, convergence_threshold=0.01)\n    expected = np.array([[0., 0.8, 0.9],\n                         [0.8, 0., 0.8],\n                         [0.9, 0.8, 0.]])\n    np.testing.assert_almost_equal(res, expected, decimal=2)\n\n\ndef test_fill_missing_links_no_missing():\n    matrix = np.asarray([[0, 0.8, 0.8],\n                         [0.8, 0, 0.8],\n                         [0.8, 0.8, 0]])\n    res = fill_missing_links(matrix, convergence_threshold=0.01)\n    expected = np.array([[0, 0.8, 0.8],\n                         [0.8, 0, 0.8],\n                         [0.8, 0.8, 0]])\n    np.testing.assert_almost_equal(res, expected, decimal=2)\n\n\ndef test_fill_missing_links_large_matrix():\n    matrix, matrix_missing = get_random_matrix_missing_values(500, 0.5)\n    res = fill_missing_links(matrix, convergence_threshold=0.01)\n    np.testing.assert_almost_equal(res, matrix, decimal=2)\n"
    },
    {
      "path": "tests/test_sampling/test_minhash_sampling.py",
      "mode": "100644",
      "type": "blob",
      "sha": "29eca08c2b20079b0a4b849832e2fe80c3db27a5",
