      "mode": "100644",
      "type": "blob",
      "sha": "1266882d1071f2aa4c4d3f4e7b06af3dcebf751a",
      "size": 228,
      "url": "https://api.github.com/repos/fritshermans/deduplipy/git/blobs/1266882d1071f2aa4c4d3f4e7b06af3dcebf751a",
      "sha256": "e193fbc6ab15a3810b343772781916cb806070b1cf25950f04fda2081ebf3e2d",
      "fully_read_this_turn": true,
      "text_content": "DEDUPLICATION_ID_NAME = 'deduplication_id'\nROW_ID = 'row_number'\nN_QUERIES = 999\nCONVERGENCE_THRESHOLD = 0.01\n\nN_PERFECT_MATCHES_TRAIN = 3\nMIN_NR_ENTRIES = 10\nUNCERTAINTY_IMPROVEMENT_THRESHOLD = 0.01\nUNCERTAINTY_THRESHOLD = 0.1\n"
