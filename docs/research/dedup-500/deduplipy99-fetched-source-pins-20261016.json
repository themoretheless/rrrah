    {
      "path": "setup.py",
      "mode": "100644",
      "type": "blob",
      "sha": "4b7c0ec2295f10eb50492f0393aed12581c142f3",
      "size": 1338,
      "url": "https://api.github.com/repos/fritshermans/deduplipy/git/blobs/4b7c0ec2295f10eb50492f0393aed12581c142f3",
      "sha256": "69e5d65d58f474546a363ce19de0ba1f13b8fe47be7cd90c59c5a0251a1df8e2",
      "fully_read_this_turn": true,
      "text_content": "from setuptools import setup, find_packages\n\nbase_packages = [\n    'pandas',\n    'numpy',\n    'scipy',\n    'scikit-learn',\n    'networkx',\n    'python-Levenshtein',\n    'thefuzz',\n    'modAL-python',\n    'openpyxl',\n    'pytest',\n    'fancyimpute',\n    'pyminhash'\n]\n\nutil_packages = [\n    \"matplotlib\",\n    \"jupyterlab\",\n]\n\ndocs_packages = [\n    \"sphinx==3.5.4\",\n    \"nbsphinx\",\n    'sphinx_rtd_theme'\n]\n\ndev_packages = base_packages + util_packages + docs_packages\n\nwith open(\"README.md\", \"r\", encoding=\"utf-8\") as fh:\n    long_description = fh.read()\n\nsetup(name='DedupliPy',\n      version='0.8',\n      author=\"Frits Hermans\",\n      description=\"End-to-end deduplication solution\",\n      long_description=long_description,\n      long_description_content_type=\"text/markdown\",\n      url=\"https://github.com/fritshermans/deduplipy\",\n      classifiers=[\n          \"Programming Language :: Python :: 3\",\n          \"License :: OSI Approved :: MIT License\",\n          \"Operating System :: OS Independent\",\n      ],\n      packages=find_packages(exclude=['notebooks']),\n      package_data={\"deduplipy\": [\"data/*.xlsx\", \"data/*.csv\"]},\n      install_requires=base_packages,\n      extras_require={\n          \"base\": base_packages,\n          \"dev\": dev_packages,\n          \"docs\": docs_packages,\n      },\n      python_requires=\">=3.6.9\",\n      )\n"
    },
