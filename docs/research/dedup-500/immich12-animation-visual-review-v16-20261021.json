  "renderer_source": "from PIL import Image,ImageDraw\nfrom pathlib import Path\nimport hashlib,json\nB=Path('.dedup-work/immich12-20261021');out={}\nfor name in ['docs--chk.gif','docs--intro.gif']:\n im=Image.open(B/name);frames=[];sheets=[];tw=400 if 'chk' in name else 320;th=round(im.height*tw/im.width);cols=4 if 'chk' in name else 5;per=20 if 'chk' in name else 30\n for idx in range(im.n_frames):\n  im.seek(idx);rgb=im.convert('RGB');frames.append({'index':idx,'duration_ms':im.info.get('duration',0),'rgb_sha256':hashlib.sha256(rgb.tobytes()).hexdigest()})\n  if idx%per==0:sheet=Image.new('RGB',(cols*tw,((min(per,im.n_frames-idx)+cols-1)//cols)*(th+22)),'white');draw=ImageDraw.Draw(sheet)\n  pos=idx%per;x=(pos%cols)*tw;y=(pos//cols)*(th+22);rgb.thumbnail((tw,th));sheet.paste(rgb,(x,y));draw.text((x+3,y+th+2),str(idx),fill='black')\n  if pos==per-1 or idx==im.n_frames-1:\n   p=B/(name.replace('.gif','')+f'-sheet-{idx//per}.jpg');sheet.save(p,quality=90);sheets.append(str(p))\n out[name]={'frames':frames,'sheets':sheets}\n(B/'gif-frame-inventory.json').write_text(json.dumps(out,indent=2)+'\\n');print(json.dumps({k:{'frames':len(v['frames']),'sheets':v['sheets']} for k,v in out.items()}))\n",
