  "decision": "reference-only-no-adoption",
  "findings": [
    {
      "kind": "static",
      "finding": "Processor handles successfulHTTP/nonrevisit only;indexhit becomes identicalpayload revisit after scheme-string digest sanitycheck. No directpayload bytecomparison in inspected path;not exactfileidentity proof."
    },
    {
      "kind": "static-risk-not-runtime-proven",
      "finding": "Bloomfilter object is assigned before daemon population thread finishes;lookup can reject records before population. Source recommends waiting for completion but inspectedlookup has no readybarrier."
    },
    {
      "kind": "static-risk-not-runtime-proven",
      "finding": "WhenuseDigestScheme true,Lucenequery uses digestWithScheme,whileBloom contains(digest) still uses rawdigest;builder inserts storedDIGEST. If storedDIGEST includes scheme,normalization differs. ActualBloomhash/runtime unqualified."
    },
    {
      "kind": "static",
      "finding": "LuceneIOexception is logged andquery returnsnull,same APIresult as nohit;error-vs-negative evidence notpreserved in inspectedquery interface."
    },
    {
      "kind": "test-source-only",
      "finding": "CapturedDeDuplicatorTest containsone percentageformatting test only;no lookup/Bloom/runtime test executed."
    },
