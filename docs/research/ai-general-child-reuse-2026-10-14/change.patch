+#[test]
+fn reused_general_child_refusals_and_cancellations_release_nested_frames() {
+    use super::native_blend::Model;
+    use hayro_interpret::color::{Color,AlphaColor};
+    use std::sync::{Arc,atomic::{AtomicUsize,Ordering}};
+    struct Credit(Arc<AtomicUsize>,usize);
+    impl Drop for Credit {fn drop(&mut self){self.0.fetch_sub(self.1,Ordering::Relaxed);}}
+    let used=Arc::new(AtomicUsize::new(0));let requests=std::cell::Cell::new(0);let deny=std::cell::Cell::new(usize::MAX);
+    let admit=|bytes| {requests.set(requests.get()+1);if requests.get()==deny.get(){return None;}
+        used.fetch_add(bytes,Ordering::Relaxed);Some(Box::new(Credit(used.clone(),bytes)) as Box<dyn std::any::Any+Send+Sync>)};
+    let rgb=Color::from_rgba(AlphaColor::new([0.,0.,0.,1.]));
+    let backdrop=Pixel::from_native(Model::Rgb,&[0.;3],0.).unwrap();
+    let path=kurbo::Rect::new(0.,0.,1.,1.).to_path(0.1);let split=kurbo::Rect::new(0.,0.,0.5,1.).to_path(0.1);
+    let regions=[(&path,Fill::NonZero),(&split,Fill::NonZero)];
+    let run=|kind,work,cancelled:&dyn Fn()->bool| {
+        let sample=|p:kurbo::Point,_:&dyn Fn()->bool,_:&mut usize,_:Option<usize>| {
+            if kind==1 {return None;}if kind==2 {return Some(None);}
+            Some(Some(NativeSpatialSample {pixel:Pixel::from_native(Model::Rgb,&[p.x,0.7,0.4],0.4).unwrap(),space:rgb.color_space(),cell_key:None}))
+        };
+        let paint=SpatialCommand::NativeSampledPaint {cells:None,field:NativeField::Unknown,regions:&[0],sample:&sample,owners:&[],alpha_is_shape:false,mode:BlendMode::Normal};
+        let commands=[SpatialCommand::Begin {isolated:false,knockout:true,opacity:0.6,alpha_is_shape:false,mode:BlendMode::HardLight},paint,
+            SpatialCommand::Begin {isolated:true,knockout:false,opacity:0.7,alpha_is_shape:true,mode:BlendMode::Screen},paint,SpatialCommand::End,paint,SpatialCommand::End];
+        compose_grouped_polygon_pixel(&regions,&commands,rgb.color_space(),backdrop,0,0,100000,work,cancelled,&admit)
+    };
+    let polls=std::cell::Cell::new(0);let expected=run(0,100000,&||{polls.set(polls.get()+1);false}).unwrap();
+    let total=requests.get();assert_eq!(used.load(Ordering::Relaxed),0);
+    for stop in 1..=total {requests.set(0);deny.set(stop);assert!(run(0,100000,&||false).is_none());assert_eq!(used.load(Ordering::Relaxed),0);}
+    deny.set(usize::MAX);
+    for stop in 1..=polls.get() {let count=std::cell::Cell::new(0);
+        assert!(run(0,100000,&||{count.set(count.get()+1);count.get()==stop}).is_none());assert_eq!(used.load(Ordering::Relaxed),0);
+    }
+    assert!(run(0,0,&||false).is_none());assert!(run(1,100000,&||false).is_none());
+    assert_eq!(run(2,100000,&||false).unwrap().alpha(),0.);
+    assert!(run(0,100000,&||false).unwrap().same_storage(expected));assert_eq!(used.load(Ordering::Relaxed),0);
+}
