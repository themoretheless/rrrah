+#[test]
+fn reused_general_child_matches_fresh_point_frames_across_nested_variable_groups() {
+    use super::native_blend::Model;
+    use hayro_interpret::color::{Color,AlphaColor};
+    use std::sync::{Arc,atomic::{AtomicUsize,Ordering}};
+    struct Credit(Arc<AtomicUsize>,usize);
+    impl Drop for Credit {fn drop(&mut self){self.0.fetch_sub(self.1,Ordering::Relaxed);}}
+    let rgb=Color::from_rgba(AlphaColor::new([0.,0.,0.,1.]));
+    let mut paths=vec![kurbo::Rect::new(0.,0.,1.,1.).to_path(0.1)];
+    for i in 0..16 {paths.push(kurbo::Rect::new(i as f64/16.,0.,(i+1) as f64/16.,1.).to_path(0.1));}
+    let regions:Vec<_>=paths.iter().map(|p|(p,Fill::NonZero)).collect();
+    let first=|p:kurbo::Point,_:&dyn Fn()->bool,_:&mut usize,_:Option<usize>|Some(Some(NativeSpatialSample {
+        pixel:Pixel::from_native(Model::Rgb,&[p.x,0.2,0.6],0.4).unwrap(),space:rgb.color_space(),cell_key:None}));
+    let second=|p:kurbo::Point,_:&dyn Fn()->bool,_:&mut usize,_:Option<usize>|Some(if p.x<0.5 {Some(NativeSpatialSample {
+        pixel:Pixel::from_native(Model::Rgb,&[0.8,p.y*0.4+0.1,0.3],0.7).unwrap(),space:rgb.color_space(),cell_key:None})} else {None});
+    let mask=|p:kurbo::Point,_:&dyn Fn()->bool|Some(0.25+p.y*0.5);
+    fn make<'a>(sample:&'a NativeSpatialSampler<'a>)->SpatialCommand<'a> {
+        SpatialCommand::NativeSampledPaint {cells:None,field:NativeField::Unknown,regions:&[0],sample,owners:&[],alpha_is_shape:false,mode:BlendMode::Normal}
+    }
+    for isolated in [false,true] {for knockout in [false,true] {for masked in [false,true] {
+        for mode in [BlendMode::Normal,BlendMode::Multiply,BlendMode::Screen,BlendMode::HardLight] {
+            let mut commands=Vec::new();if masked {commands.push(SpatialCommand::SetMask {sample:&mask,sample_cost:1});}
+            commands.extend([SpatialCommand::Begin {isolated,knockout,opacity:0.6,alpha_is_shape:false,mode},make(&first),
+                SpatialCommand::Begin {isolated:!isolated,knockout:!knockout,opacity:0.7,alpha_is_shape:true,mode:BlendMode::HardLight},
+                make(&second),SpatialCommand::End,make(&first),SpatialCommand::End]);
+            let backdrop=Pixel::from_native(Model::Rgb,&[0.2,0.7,0.4],0.6).unwrap();
+            let used=Arc::new(AtomicUsize::new(0));let frames=std::cell::Cell::new(0usize);
+            let admit=|bytes| {used.fetch_add(bytes,Ordering::Relaxed);
+                if bytes==std::mem::size_of::<super::native_frame::PaintFrame>() {frames.set(frames.get()+1);}
+                Some(Box::new(Credit(used.clone(),bytes)) as Box<dyn std::any::Any+Send+Sync>)};
+            let actual=compose_grouped_polygon_pixel(&regions,&commands,rgb.color_space(),backdrop,0,0,1_000_000,1_000_000,&||false,&admit).unwrap();
+            let actual_frames=frames.get();assert_eq!(used.load(Ordering::Relaxed),0);frames.set(0);
+            // Each reference point owns a new stack and drops it before the
+            // next fragment; no inter-fragment child state can survive.
+            let expected=compose_cells(&regions,backdrop,0,0,1_000_000,&||false,&admit,None,None,None,None,None,None,
+                &mut |_,point,_,_|compose_grouped_polygon_point(&regions,&commands,rgb.color_space(),backdrop,point,1_000_000,1_000_000,&||false,&admit)).unwrap();
+            assert!(actual.same_storage(expected),"isolated={isolated} knockout={knockout} masked={masked} mode={mode:?}");
+            assert_eq!(used.load(Ordering::Relaxed),0);
+            assert!(actual_frames*2<frames.get(),"reused={actual_frames} fresh={}",frames.get());
+        }
+    }}}
+}
