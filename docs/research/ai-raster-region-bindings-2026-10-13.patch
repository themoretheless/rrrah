+/// Per-source bindings into the deduplicated geometry arrangement. Equal
+/// screen geometry in different images never gives the images equal texels.
+pub(super) struct RasterRegionKeys {
+    color:Vec<(usize,u64)>,alpha:Vec<(usize,u64)>,alpha_present:bool,
+    _credit:Box<dyn std::any::Any+Send+Sync>,
+}
+impl RasterRegionKeys {
+    pub(super) fn counts(&self)->(usize,usize) {(self.color.len(),self.alpha.len())}
+    fn covered_key(&self,coverage:&[u64;64],remaining:&mut usize,cancelled:&dyn Fn()->bool)->Option<[u64;2]> {
+        let mut select=|bindings:&[(usize,u64)]| {
+            let mut selected=None;
+            for &(region,key) in bindings {
+                if cancelled() {return None;}*remaining=remaining.checked_sub(1)?;
+                if coverage[region/64]&(1u64<<(region%64))!=0 {
+                    if selected.is_some_and(|old|old!=key) {return None;}selected=Some(key);
+                }
+            }
+            selected
+        };
+        let color=select(&self.color)?;
+        let alpha=if self.alpha_present {select(&self.alpha)?} else {u64::MAX};
+        Some([color,alpha])
+    }
+}
+pub(super) fn admitted_raster_region_keys(color:&RasterCells,alpha:Option<&RasterCells>,regions:&[(&BezPath,Fill)],
+    remaining:&mut usize,cancelled:&dyn Fn()->bool,
+    admit:&dyn Fn(usize)->Option<Box<dyn std::any::Any+Send+Sync>>)->Option<RasterRegionKeys> {
+    if cancelled() || regions.len()>4095 || !color.has_texel_grid() || alpha.is_some_and(|a|!a.has_texel_grid()) {return None;}
+    let count=color.paths.len().checked_sub(1)?.checked_add(alpha.map_or(0,|a|a.paths.len().saturating_sub(1)))?;
+    let credit=admit(count.checked_mul(size_of::<(usize,u64)>())?)?;
+    let mut bind=|cells:&RasterCells| {
+        let mut keys=Vec::new();keys.try_reserve_exact(cells.paths.len().checked_sub(1)?).ok()?;
+        if keys.capacity()>cells.paths.len()-1 {return None;}
+        for (path_index,path) in cells.paths.iter().enumerate().skip(1) {
+            let key=cells.texel_key(path_index)?;let mut found=None;
+            for (region,(candidate,fill)) in regions.iter().enumerate() {
+                if cancelled() {return None;}*remaining=remaining.checked_sub(1)?;
+                if *fill==Fill::NonZero && (std::ptr::eq(*candidate,path) || candidate.elements()==path.elements()) {found=Some(region);break;}
+            }
+            if let Some(region)=found {
+                for &(old_region,old_key) in &keys {
+                    if cancelled() {return None;}*remaining=remaining.checked_sub(1)?;
+                    if old_region==region && old_key!=key {return None;}
+                }
+                keys.push((region,key));
+            }
+        }
+        Some(keys)
+    };
+    let color=bind(color)?;let alpha_present=alpha.is_some();
+    let alpha=if let Some(alpha)=alpha {bind(alpha)?} else {Vec::new()};
+    Some(RasterRegionKeys {color,alpha,alpha_present,_credit:credit})
+}
