+#[test]
+fn raster_region_bindings_preserve_source_scope_and_release_refused_storage() {
+    use std::sync::{Arc,atomic::{AtomicUsize,Ordering}};
+    struct Credit(Arc<AtomicUsize>,usize);
+    impl Drop for Credit {fn drop(&mut self) {self.0.fetch_sub(self.1,Ordering::Relaxed);}}
+    let used=Arc::new(AtomicUsize::new(0));
+    let admit=|bytes| {used.fetch_add(bytes,Ordering::Relaxed);Some(Box::new(Credit(used.clone(),bytes)) as Box<dyn std::any::Any+Send+Sync>)};
+    let rect=kurbo::Rect::new(0.,0.,2.,1.);
+    let a=admitted_raster_pixel_cells(4,1,kurbo::Affine::IDENTITY,rect,1000,&||false,&admit).unwrap();
+    let b=admitted_raster_pixel_cells(4,1,kurbo::Affine::translate((-1.,0.)),rect,1000,&||false,&admit).unwrap();
+    let mut regions:Vec<_>=a.paths.iter().chain(&b.paths).map(|path|(path,Fill::NonZero)).collect();
+    deduplicate_regions(&mut regions,&mut [],&||false,&admit).unwrap();
+    let baseline=used.load(Ordering::Relaxed);
+    let polls=std::cell::Cell::new(0);
+    let keys=admitted_raster_region_keys(&a,None,&regions,&mut 10000,&||{polls.set(polls.get()+1);false},&admit).unwrap();
+    let other=admitted_raster_region_keys(&b,None,&regions,&mut 10000,&||false,&admit).unwrap();
+    let mut coverage=[0u64;64];
+    for (i,(path,_)) in regions.iter().enumerate() {if path.winding(kurbo::Point::new(0.25,0.5))!=0 {coverage[i/64]|=1u64<<(i%64);}}
+    assert_eq!(keys.covered_key(&coverage,&mut 1000,&||false),Some([0,u64::MAX]));
+    assert_eq!(other.covered_key(&coverage,&mut 1000,&||false),Some([1u64<<32,u64::MAX]));
+    assert!(keys.covered_key(&coverage,&mut 0,&||false).is_none());
+    for &(region,_) in &keys.color {coverage[region/64]|=1u64<<(region%64);}
+    assert!(keys.covered_key(&coverage,&mut 1000,&||false).is_none(),"ambiguous overlapping cells must not pick an arbitrary texel");
+    drop(keys);drop(other);assert_eq!(used.load(Ordering::Relaxed),baseline);
+    for stop in 1..=polls.get() {
+        let current=std::cell::Cell::new(0);
+        assert!(admitted_raster_region_keys(&a,None,&regions,&mut 10000,&||{current.set(current.get()+1);current.get()==stop},&admit).is_none());
+        assert_eq!(used.load(Ordering::Relaxed),baseline);
+    }
+    assert!(admitted_raster_region_keys(&a,None,&regions,&mut 0,&||false,&admit).is_none());
+    assert!(admitted_raster_region_keys(&a,None,&regions,&mut 10000,&||false,&|_|None).is_none());
+    assert_eq!(used.load(Ordering::Relaxed),baseline);
+    let mut bad=admitted_raster_pixel_cells(4,1,kurbo::Affine::IDENTITY,rect,1000,&||false,&admit).unwrap();
+    bad.paths[2]=bad.paths[1].clone();
+    let retained=[(&bad.paths[1],Fill::NonZero)];let before=used.load(Ordering::Relaxed);
+    assert!(admitted_raster_region_keys(&bad,None,&retained,&mut 10000,&||false,&admit).is_none());
+    assert_eq!(used.load(Ordering::Relaxed),before);
+    drop(bad);drop(regions);drop(a);drop(b);assert_eq!(used.load(Ordering::Relaxed),0);
+}
