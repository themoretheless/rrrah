+#[test]
+fn source_field_key_preserves_generation_order_alpha_and_bounded_arity() {
+    let raster=SourceFieldIdentity::RasterCells([0,0]);
+    let mut key=FieldKey::route(7);let empty=key.words;
+    key.append(0,raster).unwrap();assert_ne!(key.words,empty);
+    let first=key.words;
+    let mut other=FieldKey::route(8);other.append(0,raster).unwrap();assert_ne!(key.words,other.words);
+    other=FieldKey::route(7);other.append(0,SourceFieldIdentity::RasterCells([0,1])).unwrap();assert_ne!(first,other.words);
+    key.append(1,SourceFieldIdentity::AffineOwner(3)).unwrap();
+    other=FieldKey::route(7);other.append(1,SourceFieldIdentity::AffineOwner(3)).unwrap();other.append(0,raster).unwrap();
+    assert_ne!(key.words,other.words);
+    key.append(2,raster).unwrap();key.append(3,raster).unwrap();let full=key.words;
+    assert!(key.append(4,raster).is_none());assert_eq!(key.words,full);
+    let observation=FieldObservation::new();observation.reset(1);
+    assert!(!observation.append(0,None));assert!(observation.key.borrow().is_none());
+    assert!(!observation.append(0,Some(raster)));
+    observation.reset(2);assert!(observation.append(0,Some(raster)));
