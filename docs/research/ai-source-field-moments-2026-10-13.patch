+#[derive(Clone,Copy)]
+struct FieldKey {words:[u64;16],len:usize}
+impl FieldKey {
+    fn route(generation:u64)->Self {let mut words=[0;16];words[0]=generation;words[1]=2;Self {words,len:2}}
+    fn append(&mut self,command:usize,identity:SourceFieldIdentity)->Option<()> {
+        let end=self.len.checked_add(3)?;if end>self.words.len() {return None;}
+        self.words[self.len]=u64::try_from(command).ok()?;
+        let payload=match identity {SourceFieldIdentity::RasterCells(key)=>key,
+            SourceFieldIdentity::AffineOwner(owner)=>[u64::try_from(owner).ok()?,u64::MAX]};
+        self.words[self.len+1..end].copy_from_slice(&payload);self.len=end;self.words[1]=end as u64;Some(())
+    }
+}
+
+struct FieldObservation {key:std::cell::RefCell<Option<FieldKey>>,work:std::cell::Cell<usize>}
+impl FieldObservation {
+    fn new()->Self {Self {key:std::cell::RefCell::new(None),work:std::cell::Cell::new(0)}}
+    fn reset(&self,generation:u64) {
+        self.work.set(self.work.get().saturating_add(19));
+        *self.key.borrow_mut()=Some(FieldKey::route(generation));
+    }
+    fn append(&self,command:usize,identity:Option<SourceFieldIdentity>)->bool {
+        self.work.set(self.work.get().saturating_add(4));
+        let mut key=self.key.borrow_mut();
+        let valid=match (key.as_mut(),identity) { (Some(key),Some(identity))=>key.append(command,identity).is_some(),_=>false};
+        if !valid {*key=None;}valid
+    }
+}
 
