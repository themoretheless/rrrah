+fn geometry_route_field_key(commands:&[SpatialCommand<'_>],route:&[usize],generation:u64,
+    coverage:&[u64;64],rasters:Option<&RasterTransitions<'_>>,owners:Option<&OwnerTransitions>,
+    work:&mut usize,cancelled:&dyn Fn()->bool)->Option<FieldKey> {
