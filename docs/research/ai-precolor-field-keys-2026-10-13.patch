+#[test]
+fn geometry_route_keys_need_no_color_sampling_and_refuse_missing_fields() {
+    use hayro_interpret::BlendMode;
+    let cells=RasterRegionKeys {color:vec![(0,10)],alpha:vec![(1,11)],alpha_present:true,_credit:Box::new(())};
+    let sample:&NativeSpatialSampler<'_>=&|_,_,_,_|panic!("precolor identity must not invoke a sampler");
+    let commands=[SpatialCommand::NativeSampledPaint {cells:Some(&cells),field:NativeField::ConstantCells,regions:&[0],sample,owners:&[],alpha_is_shape:false,mode:BlendMode::Normal},
+        SpatialCommand::NativeSampledPaint {cells:None,field:NativeField::AffineOwner,regions:&[2],sample,owners:&[(2,7)],alpha_is_shape:false,mode:BlendMode::Normal}];
+    let admit=|_|Some(Box::new(()) as Box<dyn std::any::Any+Send+Sync>);
+    let mut work=100000;let mut rasters=RasterTransitions::admitted(&commands,3,&mut work,&||false,&admit).unwrap();
+    let mut owners=OwnerTransitions::admitted(&commands,3,&mut work,&||false,&admit).unwrap();
+    let mut coverage=[0u64;64];coverage[0]=7;
+    rasters.rebuild(&coverage,&mut work,&||false).unwrap();owners.rebuild(&coverage,&mut work,&||false).unwrap();
+    let key=geometry_route_field_key(&commands,&[0,1],42,&coverage,Some(&rasters),Some(&owners),&mut work,&||false).unwrap();
+    assert_eq!(key.len,8);assert_eq!(&key.words[..key.len],&[42,8,0,10,11,1,7,u64::MAX]);
+    assert!(geometry_route_field_key(&commands,&[0,1],42,&coverage,None,Some(&owners),&mut work,&||false).is_none());
+    assert!(geometry_route_field_key(&commands,&[0,1],42,&coverage,Some(&rasters),None,&mut work,&||false).is_none());
+    assert!(geometry_route_field_key(&commands,&[0,1],42,&coverage,Some(&rasters),Some(&owners),&mut 0,&||false).is_none());
+    assert!(geometry_route_field_key(&commands,&[0,1],42,&coverage,Some(&rasters),Some(&owners),&mut work,&||true).is_none());
+    coverage[0]=3;owners.rebuild(&coverage,&mut work,&||false).unwrap();
+    assert!(geometry_route_field_key(&commands,&[0,1],42,&coverage,Some(&rasters),Some(&owners),&mut work,&||false).is_none());
