+    work: &mut usize,
+    allowance: usize,
+    cancelled: &dyn Fn() -> bool,
+) -> std::result::Result<(), super::PixelPartitionError> {
+    let initial = (*work).min(allowance);
+    let mut local = initial;
+    let result = pixel.paint_triangle(points, owner, &mut local, cancelled);
+    let spent = initial
+        .checked_sub(local)
+        .ok_or(super::PixelPartitionError::Invalid)?;
+    *work = work
+        .checked_sub(spent)
+        .ok_or(super::PixelPartitionError::Invalid)?;
+    result
+}
 
