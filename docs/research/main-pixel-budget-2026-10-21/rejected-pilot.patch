+    fn main_cost_fallback_preserves_pixels_and_releases_every_failure() {
+        let used = Arc::new(AtomicUsize::new(0));
+        let calls = Cell::new(0);
+        let deny = Cell::new(usize::MAX);
+        let admit = |bytes: usize| -> Option<Credit> {
+            calls.set(calls.get() + 1);
+            if calls.get() == deny.get() {
+                return None;
+            }
+            let next = used.load(Ordering::SeqCst).checked_add(bytes)?;
+            if next > 8 * 1024 * 1024 {
+                return None;
+            }
+            used.store(next, Ordering::SeqCst);
+            Some(Box::new(Reservation(used.clone(), bytes)))
+        };
+        let patch = source(0., 1., [0.25; 3]);
+        let refs = [AdaptivePatchRef::Tensor(&patch)];
+        let run = |limit, cancelled: &dyn Fn() -> bool| {
+            sample_patches_with_pixel_limit(&refs, Affine::IDENTITY, 3, None, cancelled, &admit, limit)
+        };
+        let check = |samples: MeshSamples| {
+            assert_eq!(samples.map.len(), 1);
+            let value = samples.map.get(&(0, 0)).unwrap();
+            assert_eq!(value.coverage, 1.);
+            assert_eq!(value.colors.as_slice(), &[0.25; 3]);
+        };
+        check(run(MAIN_PIXEL_PAINT_WORK, &|| false).unwrap());
+        let baseline_calls = calls.get();
+        assert_eq!(used.load(Ordering::SeqCst), 0);
+        calls.set(0);
+        let polls = Cell::new(0);
+        check(
+            run(0, &|| {
+                polls.set(polls.get() + 1);
+                false
+            })
+            .unwrap(),
+        );
+        let reservations = calls.get();
+        let checkpoints = polls.get();
+        assert!(reservations > baseline_calls);
+        assert_eq!(used.load(Ordering::SeqCst), 0);
+        for n in 1..=reservations {
+            calls.set(0);
+            deny.set(n);
+            assert!(run(0, &|| false).is_none());
+            assert_eq!(used.load(Ordering::SeqCst), 0);
+            deny.set(usize::MAX);
+            check(run(0, &|| false).unwrap());
+        }
+        for n in 1..=checkpoints {
+            polls.set(0);
+            assert!(
+                run(0, &|| {
+                    polls.set(polls.get() + 1);
+                    polls.get() == n
+                })
+                .is_none()
+            );
+            assert_eq!(used.load(Ordering::SeqCst), 0);
+        }
+        check(run(0, &|| false).unwrap());
+        assert_eq!(used.load(Ordering::SeqCst), 0);
+        eprintln!("MAIN_COST_CONTROL admissions={reservations} cancellations={checkpoints}");
+    }
