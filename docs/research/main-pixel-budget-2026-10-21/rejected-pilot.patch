+            component_count: 1,
+        };
+        let mut pixel = OrderedPixel::new(&admit, 32);
+        for allowance in [0, 1, 10] {
+            let mut work = 100;
+            assert_eq!(
+                paint_debited(&mut pixel, points, owner, &mut work, allowance, &|| false),
+                Err(super::super::PixelPartitionError::Limit)
+            );
+            assert_eq!(work, 100 - allowance);
+            assert_eq!(pixel.fragments(), 0);
+        }
+        let polls = Cell::new(0);
+        let mut work = 100;
+        assert_eq!(
+            paint_debited(&mut pixel, points, owner, &mut work, 5, &|| {
+                polls.set(polls.get() + 1);
