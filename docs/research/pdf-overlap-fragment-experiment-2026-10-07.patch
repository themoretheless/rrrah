+// Partition the old convex fragment into disjoint pieces outside the new one.
+fn uncovered_parts(points: &[Point], cover: &[Point]) -> Vec<Vec<Point>> {
+    let mut intersection = points.to_vec();
+    let mut outside = Vec::new();
+    let signed: f64 = (0..cover.len())
+        .map(|i| {
+            let a = cover[i];
+            let b = cover[(i + 1) % cover.len()];
+            a.x * b.y - b.x * a.y
+        })
+        .sum();
+    let sign = if signed >= 0.0 { 1.0 } else { -1.0 };
+    let mut overlap = points.to_vec();
+    for i in 0..cover.len() {
+        let a = cover[i];
+        let b = cover[(i + 1) % cover.len()];
+        if (b - a).hypot2() <= 1e-24 {
+            continue;
+        }
+        overlap = clip_half_plane(&overlap, a, b, sign);
+        if polygon_area(&overlap).is_none() {
+            return vec![points.to_vec()];
+        }
+    }
+    for i in 0..cover.len() {
+        let a = cover[i];
+        let b = cover[(i + 1) % cover.len()];
+        if (b - a).hypot2() <= 1e-24 {
+            continue;
+        }
+        let piece = clip_half_plane(&intersection, a, b, -sign);
+        if polygon_area(&piece).is_some() {
+            outside.push(piece);
+        }
+        intersection = clip_half_plane(&intersection, a, b, sign);
+        if polygon_area(&intersection).is_none() {
+            break;
+        }
+    }
+    outside
+}

