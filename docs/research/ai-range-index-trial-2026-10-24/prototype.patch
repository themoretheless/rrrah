+const SPAN_RECORDS: usize = 16;
+const MIN_INDEXED_REGIONS: usize = 128;
+#[derive(Clone, Copy)]
+struct RegionSpan {
+    bounds: [f64; 4],
+    eligible: bool,
+}
+impl RegionSpan {
+    fn empty() -> Self {
+        Self {
+            bounds: [f64::INFINITY, f64::INFINITY, f64::NEG_INFINITY, f64::NEG_INFINITY],
+            eligible: true,
+        }
+    }
+    fn include_bounds(&mut self, b: [f64; 4]) {
+        self.bounds[0] = self.bounds[0].min(b[0]);
+        self.bounds[1] = self.bounds[1].min(b[1]);
+        self.bounds[2] = self.bounds[2].max(b[2]);
+        self.bounds[3] = self.bounds[3].max(b[3]);
+    }
+    fn disjoint(&self, b: [f64; 4]) -> bool {
+        !(self.bounds[0] < b[2] && b[0] < self.bounds[2] && self.bounds[1] < b[3] && b[1] < self.bounds[3])
+    }
+}
+fn represented_bounds(p: &Polygon) -> [f64; 4] {
+    let mut span = RegionSpan::empty();
+    for p in &p.points[..p.len] {
+        span.include_bounds([p.x, p.y, p.x, p.y]);
+    }
+    span.bounds
+}
+#[derive(Clone, Copy)]
+struct CopiedRun {
+    new_start: usize,
+    old_start: usize,
+    len: usize,
+}
+fn invalidate_copied_runs(
+    runs: &mut AdmittedVec<'_, CopiedRun>,
+    dirty: usize,
+    work: &mut usize,
+    cancelled: &dyn Fn() -> bool,
+) -> Result<()> {
+    if dirty == usize::MAX {
+        return Ok(());
+    }
+    while let Some(last) = runs.values.last() {
+        tick(work, cancelled)?;
+        if last.new_start + last.len <= dirty {
+            break;
+        }
+        runs.values.pop();
+    }
+    Ok(())
+}
+fn copy_retained_run(
+    next: &mut AdmittedVec<'_, Fragment>,
+    runs: &mut AdmittedVec<'_, CopiedRun>,
+    old: &[Fragment],
+    start: usize,
+    end: usize,
+    track: bool,
+    work: &mut usize,
+    cancelled: &dyn Fn() -> bool,
+) -> Result<()> {
+    if track {
+        invalidate_copied_runs(runs, next.dirty_from, work, cancelled)?;
+        next.dirty_from = usize::MAX;
+    }
+    let new_start = next.values.len();
+    next.extend_copy(&old[start..end], work, cancelled)?;
+    if track {
+        runs.push(CopiedRun {
+            new_start,
+            old_start: start,
+            len: end - start,
+        })?;
+    }
+    Ok(())
+}
+fn build_region_spans<'a>(
+    next: &AdmittedVec<'a, Fragment>,
+    old: &AdmittedVec<'a, RegionSpan>,
+    runs: &AdmittedVec<'_, CopiedRun>,
+    work: &mut usize,
+    cancelled: &dyn Fn() -> bool,
+) -> Result<AdmittedVec<'a, RegionSpan>> {
+    let mut spans = AdmittedVec::new(next.admit, next.maximum.div_ceil(SPAN_RECORDS));
+    if next.values.len() < MIN_INDEXED_REGIONS {
+        return Ok(spans);
+    }
+    let mut cursor = 0;
+    for start in (0..next.values.len()).step_by(SPAN_RECORDS) {
+        tick(work, cancelled)?;
+        let end = (start + SPAN_RECORDS).min(next.values.len());
+        while cursor < runs.values.len() && runs.values[cursor].new_start + runs.values[cursor].len <= start {
+            tick(work, cancelled)?;
+            cursor += 1;
+        }
+        let copied = runs
+            .values
+            .get(cursor)
+            .filter(|r| r.new_start <= start && end <= r.new_start + r.len);
+        let mut span = RegionSpan::empty();
+        if let Some(run) = copied {
+            let old_start = run.old_start + (start - run.new_start);
+            let old_end = old_start + (end - start);
+            for index in old_start / SPAN_RECORDS..=(old_end - 1) / SPAN_RECORDS {
+                tick(work, cancelled)?;
+                let summary = old.values.get(index).ok_or(PixelPartitionError::Invalid)?;
+                span.include_bounds(summary.bounds);
+                span.eligible &= summary.eligible;
+            }
+        } else {
+            for fragment in &next.values[start..end] {
+                tick(work, cancelled)?;
+                span.include_bounds(represented_bounds(&fragment.polygon));
+                span.eligible &= fragment.has_area && fragment.no_merge_with_previous;
+            }
+        }
+        spans.push(span)?;
+    }
+    Ok(spans)
+}
