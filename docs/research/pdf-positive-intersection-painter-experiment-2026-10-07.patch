+type PixelPolygon = smallvec::SmallVec<[Point; 8]>;
+fn split_pixel_polygon(polygon: &[Point], a: Point, b: Point) -> (PixelPolygon, PixelPolygon) {
+    let distance = |p: Point| (b.x-a.x)*(p.y-a.y)-(b.y-a.y)*(p.x-a.x);
+    let mut inside = PixelPolygon::new();
+    let mut outside = PixelPolygon::new();
+    for i in 0..polygon.len() {
+        let p = polygon[i];
+        let q = polygon[(i+1)%polygon.len()];
+        let dp = distance(p);
+        let dq = distance(q);
+        if dp >= 0. { inside.push(p); }
+        if dp <= 0. { outside.push(p); }
+        if (dp < 0. && dq > 0.) || (dp > 0. && dq < 0.) {
+            let crossing = p + (q-p) * (dp / (dp-dq));
+            inside.push(crossing);
+            outside.push(crossing);
+        }
+    }
+    (inside, outside)
+}
+fn pixel_polygon_area(polygon: &[Point]) -> Option<(f32, Point)> {
