+#[test] fn bitwise_grid_and_edge_oracle(){let mut checked=0;for family in 0..4 {let mut pixels=Vec::new();for i in 0..35 {let r=(i as f32-17.)/3.;pixels.extend([r,-r,r*0.7,if family==0{0.}else if family==1{0.5}else{1.}]);}let image=LinearRgbaView::new(7,5,&pixels,35,||false).unwrap();for yi in 0..49 {for xi in 0..73 {let p=[xi as f64/12.,yi as f64/12.];for space in [FilterColorSpace::LinearSrgb,FilterColorSpace::EncodedSrgb]{assert_eq!(reference(&image,p,space).map(|p|p.map(f64::to_bits)),interpolate_in_space(&image,p,space).map(|p|p.map(f64::to_bits)),"{family} {p:?}");checked+=1;}}}}assert_eq!(checked,28616);}
