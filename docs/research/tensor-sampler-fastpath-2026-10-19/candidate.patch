+// Reusing cached coefficients is bit-preserving for identity transforms on
+// normal coordinates and positive zero. Keep the original arithmetic for signed
+// zero, subnormals and nonfinite inputs.
+fn triangle_in_device_space(t: Triangle, transform: Affine) -> Triangle {
+    if transform == Affine::IDENTITY && [&t.p0,&t.p1,&t.p2].iter().all(|v|
+        [v.point.x,v.point.y].iter().all(|x|x.is_normal() || x.to_bits()==0)) {
+        return t;
+    }
+            let p0 = transform * t.p0.point;
+            let p1 = transform * t.p1.point;
+            let p2 = transform * t.p2.point;
+
+            let mut v0 = t.p0.clone();
+            v0.point = p0;
+            let mut v1 = t.p1.clone();
+            v1.point = p1;
+            let mut v2 = t.p2.clone();
+            v2.point = p2;
+
+            Triangle::new(v0, v1, v2)
+
