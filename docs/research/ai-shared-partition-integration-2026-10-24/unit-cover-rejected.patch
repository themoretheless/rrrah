+// Exact four-corner coverage proof. No area tolerance, allocation or source
+// interpolation is involved; the cyclic boundary must be the whole unit square.
+#[cfg(feature = "experimental-shared-partitions")]
+fn is_unit_square(polygon: &Polygon, work: &mut usize, cancelled: &dyn Fn() -> bool) -> Result<bool> {
+    tick(work, cancelled)?;
+    if polygon.len != 4 { return Ok(false); }
+    let mut first = 0;
+    let mut previous = 0;
+    for (i, point) in polygon.points[..4].iter().enumerate() {
+        tick(work, cancelled)?;
+        let corner = if point.x == 0. && point.y == 0. { 0 }
+            else if point.x == 1. && point.y == 0. { 1 }
+            else if point.x == 1. && point.y == 1. { 2 }
+            else if point.x == 0. && point.y == 1. { 3 }
+            else { return Ok(false); };
+        if i == 0 { first = corner; }
+        else if corner != (previous + 1) % 4 { return Ok(false); }
+        previous = corner;
+    }
+    Ok((previous + 1) % 4 == first)
+}
