+        text = (f"ORDERED_CELL_BEGIN bits=[0, 0, {struct.unpack('>Q', struct.pack('>d', 1.))[0]}] candidates={len(lines)} work=100000000\n"
+                + "\n".join("ORDERED_CELL_ROW " + line for line in lines) + "\nORDERED_CELL_END\n")
+        rows = extract(text)[0]["rows"]
