    {
      "kind": "native_runtime",
      "finding": "Full sha1_file stream matches independent hashlib byte oracle at7sizes0..65537 across1KiB block boundaries."
    },
    {
      "kind": "native_runtime",
      "finding": "Same-size replacement with restored mtime stays marked unmodified and old duplicate group survives although actual file hashes differ. is_file_in trusts stale cached digest after content replacement."
    },
    {
      "kind": "native_runtime",
      "finding": "Web eager list(hash_for_update()) updates duplicate statistics before hashes; after update_hash loop duplicate rows exist but displayed count remains0. Lazy CLI generator order updates statistics correctly."
    },
    {
      "kind": "native_runtime_with_injection",
      "finding": "Controlled identical digest for unequal owned files publishes duplicate group without byte confirmation; synthetic collision only, not a real SHA1 collision."
    },
    {
      "kind": "native_runtime_with_injection",
      "finding": "Injected os.remove failure occurs after SQL DELETE: own connection sees missing row while file remains; explicit rollback restores row. No real protected files touched."
    },
    {
      "kind": "native_runtime_with_injection",
      "finding": "Mutation after prehash stat yields saved oldsize alongside hash of new longer bytes; no postread verification."
    },
    {
      "kind": "source_only",
      "finding": "list_files swallows directory OSError as empty, then update_tree deletes cached entries for inaccessible subtree. Follow-links recursion lacks inode/cycle guard; nonregular files not explicitly rejected."
    },
    {
      "kind": "source_only",
      "finding": "Hash-only identity, no byte confirmation or size grouping before hashing; all file contents read1KiB at a time, per-file SQLcommit. sqlite hash queries lack index on hash. Optimization candidates require measured workload and preserved snapshot/transaction semantics."
    },
    {
      "kind": "source_only",
      "finding": "Metadata/exclude files overwritten nonatomically. get_duplicated groups across sizes, first row size drives savings. Meta stats can become stale after deletion. No cancellation/resource cap."
    },
    {
      "kind": "source_only",
      "finding": "Web mutation routes include GET update/delete with no CSRF guard; arbitrary directory addition, prefix-based cache deletion and user-supplied metadata path require trust boundary review. No endpoint/network/security exploit executed."
    },
    {
      "kind": "source_only",
      "finding": "All templates and both CSS files read including bundled normalize.css MIT notice. No tracked images/video. No browser rendering or UI behavior qualification. Travis performs flake8 only, no original tests."
    }
