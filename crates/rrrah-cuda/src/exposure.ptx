.version 6.0
.target sm_52
.address_size 64

.visible .entry rrrah_exposure(
    .param .u64 input,
    .param .u64 output,
    .param .u32 count,
    .param .f32 gain
)
{
    .reg .pred %p;
    .reg .b32 %r<5>;
    .reg .b64 %d<5>;
    .reg .f32 %f<5>;
    ld.param.u64 %d0, [input];
    ld.param.u64 %d1, [output];
    ld.param.u32 %r0, [count];
    ld.param.f32 %f0, [gain];
    mov.u32 %r1, %ctaid.x;
    mov.u32 %r2, %ntid.x;
    mov.u32 %r3, %tid.x;
    mad.lo.u32 %r4, %r1, %r2, %r3;
    setp.ge.u32 %p, %r4, %r0;
    @%p bra done;
    mul.wide.u32 %d2, %r4, 16;
    add.u64 %d3, %d0, %d2;
    add.u64 %d4, %d1, %d2;
    ld.global.v4.f32 {%f1, %f2, %f3, %f4}, [%d3];
    mul.rn.f32 %f1, %f1, %f0;
    mul.rn.f32 %f2, %f2, %f0;
    mul.rn.f32 %f3, %f3, %f0;
    st.global.v4.f32 [%d4], {%f1, %f2, %f3, %f4};
done:
    ret;
}
