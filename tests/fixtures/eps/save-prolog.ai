%!PS-Adobe-3.0 EPSF-3.0
%%Creator: rrrah CC0 authored VM rollback control
%%BoundingBox: 0 0 8 8
%%EndComments
/a [1 0 0] def /p {a aload pop setrgbcolor} def
save /outer exch def
a 0 0 put a 1 1 put
/p load bind pop p 1 1 3 3 rectfill
save /inner exch def
0 0 1 setrgbcolor 0 5 2 2 rectfill
inner restore
gsave 0 setgray grestoreall
outer restore
p 5 1 2 3 rectfill
showpage
%%EOF
